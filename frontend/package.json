{
  "name": "gotour-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GoTour - premium travel booking platform frontend (React 19 + TypeScript + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
