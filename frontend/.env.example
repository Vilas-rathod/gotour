# Base URL of the API gateway. Leave as /api to use the Vite dev proxy.
VITE_API_BASE_URL=/api

# Absolute gateway URL used by `vite dev` when proxying.
VITE_PROXY_TARGET=http://localhost:8080

# Public key surfaced by the payment service (mock provider in development).
VITE_PAYMENT_PUBLIC_KEY=gotour_mock_public_key
