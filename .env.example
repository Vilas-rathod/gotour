# Copy to .env and adjust. docker-compose reads these.

# --- Database ---
MYSQL_ROOT_PASSWORD=1234

# --- Security ---
# HS512 signing secret. MUST be >= 64 characters. Change for any real deployment.
GOTOUR_JWT_SECRET=gotour-dev-secret-key-please-change-in-production-min-64-chars-long-2026!!

# --- CORS ---
# Browser origins allowed to call the API gateway. In production set this to your
# deployed frontend URL, e.g. https://your-app.vercel.app (comma-separated, NO
# trailing slash). Preview/branch URLs are NOT matched — use the exact prod origin.
GOTOUR_CORS_ORIGINS=http://localhost:5176,http://localhost:8090

# --- Payments ---
# Two methods are offered at checkout: RAZORPAY (online UPI / BHIM) and CASH
# (pay at the hotel on arrival — hotel bookings only). This is just the default
# used when a checkout request does not name a method; leave it as RAZORPAY.
# Paste your Razorpay key id/secret below to accept online payments.
GOTOUR_PAYMENT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
